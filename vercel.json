{
    "version": 2,
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.py": {
            "excludeFiles": "{obsidian-command/**,dist/**,node_modules/**,voicebot-ui/**,venv/**,data/**,tests/**,docs/**,scripts/**,backend/**,deploy_dist/**}"
        }
    }
}