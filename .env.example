# =============================================================================
# Agentic AI Voice Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Gateway Service ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=4

# --- Orchestrator Service ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8001

# --- STT Service ---
STT_HOST=0.0.0.0
STT_PORT=8002
STT_PROVIDER=deepgram  # deepgram | whisper
DEEPGRAM_API_KEY=your_deepgram_api_key_here
WHISPER_MODEL_SIZE=base  # tiny | base | small | medium | large

# --- LLM Service ---
LLM_HOST=0.0.0.0
LLM_PORT=8003
LLM_PROVIDER=openai  # openai | anthropic | groq | openrouter
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Speech-to-speech pipeline (pipeline_mode=speech_speech on a bot config)
# Uses gpt-4o-realtime-preview-2024-12-17 by default. Override per-bot via s2s_model field.
# Supported s2s_voice values: alloy ash ballad coral echo sage shimmer verse
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_STREAMING=true

# --- OpenRouter (unified gateway — 300+ models via one API key) ---
# Get your key at https://openrouter.ai/keys
# Set llm_provider="openrouter" on a bot, or use any "provider/model" slug as llm_model.
# Popular slugs:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o
#   meta-llama/llama-3.3-70b-instruct
#   google/gemini-2.0-flash-001
#   mistralai/mistral-large
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct

# --- TTS Service ---
TTS_HOST=0.0.0.0
TTS_PORT=8004
TTS_PROVIDER=elevenlabs  # elevenlabs | azure | google
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL=3600

# --- Memory Service ---
MEMORY_HOST=0.0.0.0
MEMORY_PORT=8005

# --- Guardrail Service ---
GUARDRAIL_HOST=0.0.0.0
GUARDRAIL_PORT=8006

# --- Media Service ---
MEDIA_HOST=0.0.0.0
MEDIA_PORT=8007

# --- LiveKit (WebRTC) ---
# Server: docker run --rm -p 7880:7880 -p 7881:7881/udp -p 50000-50100:50000-50100/udp livekit/livekit-server:latest --dev
# Default dev API key/secret (change for production):
# Use 127.0.0.1 if "Failed to fetch" / signal WS fails (localhost → ::1 vs Docker IPv4).
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional: URL the *browser* uses (LAN IP / tunnel). Overrides LIVEKIT_URL in session JSON only.
# LIVEKIT_CLIENT_URL=ws://192.168.1.10:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# JWT generation requires: pip install livekit-api (in the same venv as uvicorn)

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=3600

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=voicebot
POSTGRES_PASSWORD=voicebot_secret
POSTGRES_DB=voicebot

# --- Vector DB (Pinecone) ---
VECTOR_DB_PROVIDER=pinecone  # pinecone | weaviate
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=voicebot-memory

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=voicebot-group

# --- Security ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_ENDPOINT=http://localhost:14268/api/traces
ENABLE_TRACING=true
ENABLE_METRICS=true

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Obsidian UI (Vite) — copy into obsidian-command/.env.local ---
# VITE_API_BASE=http://localhost:8000/api/v1
# Optional: full WebSocket base if API is on another host (no path; default derived from VITE_API_BASE)
# VITE_VOICE_WS_BASE=ws://localhost:8000
